# =============================================================================
# StayFlow — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="StayFlow"
APP_ENV=development        # development | staging | production
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:3000
MOBILE_URL=exp://localhost:8081

# -----------------------------------------------------------------------------
# Security / JWT
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=stayflow
POSTGRES_PASSWORD=stayflow_dev_password
POSTGRES_DB=stayflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full connection string (auto-constructed from above in production)
DATABASE_URL=postgresql+asyncpg://stayflow:stayflow_dev_password@localhost:5432/stayflow

# For Alembic (sync driver)
DATABASE_URL_SYNC=postgresql://stayflow:stayflow_dev_password@localhost:5432/stayflow

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=stayflow_redis_password
REDIS_URL=redis://:stayflow_redis_password@localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://:stayflow_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:stayflow_redis_password@localhost:6379/2

# -----------------------------------------------------------------------------
# Object Storage (S3-compatible — MinIO for dev)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=minio             # minio | aws_s3 | cloudflare_r2 | local
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=stayflow_minio
STORAGE_SECRET_KEY=stayflow_minio_password
STORAGE_REGION=us-east-1
STORAGE_BUCKET_DOCUMENTS=stayflow-documents
STORAGE_BUCKET_PHOTOS=stayflow-photos
STORAGE_SIGNED_URL_EXPIRES=3600    # seconds

# MinIO console
MINIO_ROOT_USER=stayflow_minio
MINIO_ROOT_PASSWORD=stayflow_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# OCR Provider
# -----------------------------------------------------------------------------
OCR_PROVIDER=mock                  # mock | google_vision | aws_textract | azure_di
# Google Vision (if OCR_PROVIDER=google_vision)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# AWS Textract (if OCR_PROVIDER=aws_textract)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging
# -----------------------------------------------------------------------------
FCM_PROVIDER=log                   # log | firebase
# FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/firebase-service-account.json

# -----------------------------------------------------------------------------
# WhatsApp (future integration)
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=disabled         # disabled | twilio | meta_cloud_api
# WHATSAPP_API_KEY=...
# WHATSAPP_PHONE_NUMBER_ID=...

# -----------------------------------------------------------------------------
# Document Retention
# -----------------------------------------------------------------------------
# How long to keep ID documents (days). 0 = keep forever.
DOCUMENT_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# -----------------------------------------------------------------------------
# Next.js Admin Panel
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=StayFlow

# -----------------------------------------------------------------------------
# Expo Mobile App
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_APP_NAME=StayFlow
