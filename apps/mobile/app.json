{
  "expo": {
    "name": "StayFlow",
    "slug": "stayflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stayflow.app"
    },
    "android": {
      "package": "com.stayflow.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "StayFlow needs camera access for ID document scanning."
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "stayflow",
    "extra": {
      "apiUrl": "http://192.168.1.4:8000/api/v1"
    }
  }
}
